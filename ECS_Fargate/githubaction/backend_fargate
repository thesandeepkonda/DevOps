name: push docker image to hub and deploy to Fargate
on:
  push:
    branches:
      - main
  workflow_dispatch:

# CRITICAL: Required for AWS OIDC authentication
permissions:
  id-token: write
  contents: read

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Cleanup build folder
        run: |
          rm -rf ./* || true
          rm -rf ./.??* || true

      - name: Checkout code
        uses: actions/checkout@v3
        with:
          fetch-depth: 2

      - name: Install required packages
        run: sudo apt-get update && sudo apt-get install -y apt-transport-https ca-certificates curl unzip git jq wget

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v2
        with:
          terraform_version: 1.13.3

      # -----------------------------
      # Configure AWS using GitHub OIDC
      # -----------------------------
      - name: Configure AWS
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_GITHUB_ACTIONS_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: whoami
        run: aws sts get-caller-identity

      # -----------------------------
      # Detect changed top-level folders
      # -----------------------------
      - name: Detect changed top-level folders
        id: changes
        run: |
          CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD | cut -d/ -f1 | sort -u | tr '\n' ' ')
          echo "changed=$CHANGED" >> $GITHUB_OUTPUT

      - name: Install yq
        run: |
          sudo wget -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/v4.40.5/yq_linux_amd64
          sudo chmod +x /usr/local/bin/yq

      - name: Set image variables
        id: image
        run: |
          VERSION=$(yq e '.tag' values.yaml)
          REPO=$(yq e '.project' values.yaml)

          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "repo=$REPO" >> $GITHUB_OUTPUT

      # -----------------------------
      # ECR Infrastructure Initialization
      # -----------------------------
      - name: Ensure ECR exists via Terraform
        run: |
          terraform -chdir=terraform/ecs_rds init
          # Target only the ECR repository inside your ECS module to ensure it exists before docker push
          terraform -chdir=terraform/ecs_rds apply -target="module.ecs.aws_ecr_repository.this" -var-file=use.tfvars -auto-approve

      - name: ECR Login
        run: |
          REPO="${{ secrets.AWS_ACCOUNT_ID }}.dkr.ecr.${{ secrets.AWS_REGION }}.amazonaws.com/${{ steps.image.outputs.repo }}"
          aws ecr get-login-password --region ${{ secrets.AWS_REGION }} | \
          docker login --username AWS --password-stdin $REPO

      # -----------------------------
      # Build and push Docker image
      # -----------------------------
      - name: Build and push Docker image
        run: |
          CHANGED="${{ steps.changes.outputs.changed }}"
          REPO="${{ secrets.AWS_ACCOUNT_ID }}.dkr.ecr.${{ secrets.AWS_REGION }}.amazonaws.com/${{ steps.image.outputs.repo }}"
          VERSION="${{ steps.image.outputs.version }}"
          
          if [[ "$CHANGED" == *"src"* || "$CHANGED" == *"pom.xml"* || "$CHANGED" == *"values.yaml"* || "$CHANGED" == *"terraform"* ]]; then
            if [ -f "Dockerfile" ]; then
              REPO_NAME=$(echo $REPO | cut -d/ -f2- | cut -d: -f1)
              EXISTS=$(aws ecr describe-images --repository-name $REPO_NAME --image-ids imageTag=$VERSION --query 'imageDetails[0].imageTags[0]' --output text 2>/dev/null || echo NOT_FOUND)
              
              if [ "$EXISTS" = "NOT_FOUND" ]; then
                docker buildx build -t $REPO:$VERSION .
                docker push $REPO:$VERSION
                docker rmi $REPO:$VERSION
                docker system prune -af
              else
                echo "Image $REPO:$VERSION already exists in ECR. Skipping build."
              fi
            fi
          else
            echo "No relevant changes detected. Skipping Docker build."
          fi

      # -----------------------------
      # Deploy application to ECS Fargate
      # -----------------------------
      - name: Deploy application
        run: |
          # Use the exact REPO name from values.yaml as the JSON key
          export TF_VAR_image_tags="{\"${{ steps.image.outputs.repo }}\":\"${{ steps.image.outputs.version }}\"}"
          
          terraform -chdir=terraform/ecs_rds init
          terraform -chdir=terraform/ecs_rds apply -var-file=use.tfvars -auto-approve

      # -----------------------------
      # Final cleanup
      # -----------------------------
      - name: Final Cleanup
        if: always()
        run: |
          rm -rf ./* || true
          rm -rf ./.??* || true